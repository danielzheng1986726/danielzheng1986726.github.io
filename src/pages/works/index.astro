---
import Base from '../../layouts/Base.astro';
import Stamp from '../../components/Stamp.astro';
import WorkThumb from '../../components/WorkThumb.astro';
import { getCollection } from 'astro:content';
const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const rank = { '在用': 0, '用过一次': 1, '已停': 2 };
const tools = (await getCollection('tools')).sort((a, b) => rank[a.data.status] - rank[b.data.status] || b.data.updated.localeCompare(a.data.updated));
const repo = 'https://github.com/danielzheng1986726/daniel-tools';
---
<Base title="做过的" current="/works/">
  <h1>做过的</h1>
  <p class="sub">每件事都按同一个顺序写：遇到什么问题，怎么做的，拿什么验证，边界在哪。</p>
  <ul class="notices">
    {works.map((w) => (
      <li class="notice">
        <a href={`/works/${w.id}/`}><WorkThumb work={w} /></a>
        <div class="body">
          <h3><a href={`/works/${w.id}/`}>{w.data.title.replace(/(\d) /g, "$1\u00a0")}</a></h3>
          <p>{w.data.name} · {w.data.tags.join(' · ')}</p>
        </div>
        <Stamp status={w.data.status} />
      </li>
    ))}
  </ul>
  {tools.length ? (
    <>
      <h2 id="tools">顺手做的 <a href={repo}>GitHub →</a></h2>
      <p class="sub">身边冒出来的小麻烦，顺手写个工具解决掉。代码都在一个公开仓库里，拿去用之前先看每个文件夹里的说明。</p>
      <ul class="tools">
        {tools.map((t) => (
          <li>
            <div class="tl"><a href={`${repo}/tree/main/${t.id}`}>{t.data.name}</a><span class="meta">{t.data.form} · {t.data.status}</span></div>
            <p>{t.data.pain}</p>
          </li>
        ))}
      </ul>
    </>
  ) : null}
</Base>
