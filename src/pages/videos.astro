---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const videos = (await getCollection('videos')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const ymd = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---
<Base title="拍过的" current="/videos/">
  <h1>拍过的</h1>
  <p class="sub">每天一条口播，讲 HR 怎么用 AI。有 B 站编号的能在这里直接看，其余点过去看。全部在 <a href="https://space.bilibili.com/20930172">B 站</a>。</p>
  <ul class="videos">
    {videos.map((v) => (
      <li>
        {v.data.cover ? <img src={v.data.cover} alt={v.data.title} loading="lazy" /> : <div></div>}
        <div>
          <h3>{v.data.title}</h3>
          <p>{ymd(v.data.date)}{v.data.xhs ? <> · <a href={v.data.xhs}>小红书</a></> : null}{v.data.douyin ? <> · <a href={v.data.douyin}>抖音</a></> : null}</p>
          {v.data.bvid ? <div class="player"><iframe src={`https://player.bilibili.com/player.html?bvid=${v.data.bvid}&autoplay=0&danmaku=0`} scrolling="no" allowfullscreen="true" loading="lazy"></iframe></div> : null}
        </div>
      </li>
    ))}
  </ul>
</Base>
